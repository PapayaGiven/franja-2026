# FRANJA 2026 — Supabase
#
# Copy to .env.local and fill in the values from
# https://supabase.com/dashboard/project/<your-project>/settings/api
#
# The service-role key bypasses RLS and is server-only. Never expose it
# to the browser (no NEXT_PUBLIC_ prefix).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Single shared password for the /admin panel. Anyone with this string
# can sign in and write to the database (server-side, via the service
# role key). Rotate in Vercel to invalidate all active sessions.
ADMIN_PASSWORD=change-me-in-vercel
